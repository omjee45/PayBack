# ─── Backend  (copy to backend/.env) ────────────────────────────────────────

DATABASE_URL="file:./dev.db"
PORT=3001

# ─── Razorpay TEST Mode ───────────────────────────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ─── Gemini API ───────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey  (free tier, no card needed)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# Auto-tick every 5 min (set true only for unattended demos)
AUTO_CRON_ENABLED=false

# ─── Frontend  (copy to frontend/.env) ───────────────────────────────────────
# Leave blank in dev — Vite proxies /api/* to the backend automatically
VITE_API_URL=
